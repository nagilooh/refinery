abstract class Vehicle {
    Vehicle supports
    Mission assignedTo
}

class StarShip extends Vehicle.
class ShuttleCraft extends Vehicle.

class Mission.

% TEST: type constraint 1

error invalidSupport(a, b) <->
    StarShip(a),
    ShuttleCraft(b),
    supports(a, b).

ShuttleCraft(shuttle1).
supports(shuttle2, shuttle1).
!supports(StarShip::new, *).

% EXPECT:

!StarShip(shuttle2).

% TEST: type constraint 2

error invalidSupport(a, b) <->
    StarShip(a),
    ShuttleCraft(b),
    supports(a, b).

StarShip(star).
supports(star, ship2).
default !supports(*, *).

% EXPECT:

!ShuttleCraft(ship2).

% TEST: relation constraint


error invalidSupport(a, b) <->
    StarShip(a),
    ShuttleCraft(b),
    supports(a, b).

StarShip(star).
ShuttleCraft(shuttle).

% EXPECT:

!supports(StarShip::new, ShuttleCraft::new).
!supports(StarShip::new, shuttle).
!supports(star, ShuttleCraft::new).
!supports(star, shuttle).

% TEST: negated relation constraint

error supportNotOnSupportedMission(a) <->
    supports(a, b),
    assignedTo(b, m),
    !assignedTo(a, m).

supports(ship1, ship2).
assignedTo(ship2, mission).

% EXPECT:

assignedTo(ship1, mission).

% TEST: not positively bound variable 1

error test(a) <->
    assignedTo(a, _),
    supports(_, a),
    supports(a, _).

supports(x, s1).
supports(s1, y).

StarShip(s2).
Vehicle(s3).
Mission(m1).

% EXPECT:

!assignedTo(s1, *).

% TEST: not positively bound variable 2

error test(a) <->
    assignedTo(a, _),
    supports(_, a),
    supports(a, _).

assignedTo(s1, m1).
supports(s1, y).

StarShip(s2).
Vehicle(s3).
Mission(m1).

% EXPECT:

!supports(*, s1).

% TEST: not positively bound variable 3

error test(a) <->
    assignedTo(a, _),
    supports(_, a),
    supports(a, _).

assignedTo(s1, m1).
supports(x, s1).

StarShip(s2).
Vehicle(s3).
Mission(m1).

% EXPECT:

!supports(s1, *).

% TEST: Disjunction in error predicate

class Probe extends Vehicle.

error supportLoop(a) <->
    StarShip(a),
    supports+(a, a)
;
    ShuttleCraft(a),
    supports+(a, a).

supports(s1, s2).
supports(s2, s3).
supports(s3, s4).
supports(s4, s1).

% EXPECT:

!ShuttleCraft(s1).
!ShuttleCraft(s2).
!ShuttleCraft(s3).
!ShuttleCraft(s4).
!StarShip(s1).
!StarShip(s2).
!StarShip(s3).
!StarShip(s4).
Probe(s1).
Probe(s2).
Probe(s3).
Probe(s4).

% TEST: Negation in error predicate

class Probe extends Vehicle.

error supportLoop(a) <->
    !Probe(a),
    supports+(a, a).

supports(s1, s2).
supports(s2, s3).
supports(s3, s4).
supports(s4, s1).

% EXPECT:
Probe(s1).
Probe(s2).
Probe(s3).
Probe(s4).

% TEST: self loop

error selfLoop(Vehicle v) <->
    supports(v, v).

ShuttleCraft(shuttle).

% EXPECT:

!supports(shuttle, shuttle).


