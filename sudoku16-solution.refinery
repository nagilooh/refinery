class Row {
    Field[16] field opposite row
}

class Column {
    Field[16] field opposite column
}

class Block {
    Field[16] field opposite block
}

class Field {
    Row[1] row opposite field
    Column[1] column opposite field
    Block[1] block opposite field
    Number[1] number
}

class Number.

